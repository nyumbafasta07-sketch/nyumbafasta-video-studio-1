# Copy to .env and fill in. NEVER commit .env.
# Regenerate the hash with:  npm run hash-password -- "your-password"

# --- auth (single-user local gate) ---
APP_PASSWORD_HASH=
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=720

# --- providers (Phase 2: all mock) ---
SCRIPT_PROVIDER=mock
VOICE_PROVIDER=mock
FACE_PROVIDER=mock
LIPSYNC_PROVIDER=mock
RENDERER=ffmpeg
GPU_PROVIDER=local-mock
TRAINING_PROVIDER=mock

# --- gpu worker (used when GPU_PROVIDER=http or TRAINING_PROVIDER=worker) ---
# These are just DEFAULTS — Settings → Compute in the app can override the
# provider choice, worker URL and token at runtime without a restart.
GPU_WORKER_URL=
GPU_WORKER_TOKEN=

# --- storage ---
STORAGE_DIR=./storage
DATABASE_FILE=./storage/studio.sqlite

# --- output defaults ---
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920
GREEN_SCREEN_HEX=#00b140
